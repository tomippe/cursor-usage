# Open VSX personal access token（正本: ~/Secrets/open-vsx.env。代替: ~/.ovsx-env）
# Create at: https://open-vsx.org/user-settings/tokens
OPEN_VSX_TOKEN=

# WordPress 紹介ページ（apps.tomippe.jp）
# 認証は ~/.wp-env（WP_USER / WP_APP_PASSWORD / WP_SITE_URL）
WP_APP_POST_ID=
WP_APP_PAGE_URL=https://apps.tomippe.jp/cursor-usage/
